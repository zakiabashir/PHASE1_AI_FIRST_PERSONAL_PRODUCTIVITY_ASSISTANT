# =============================================================================
# Docker Environment Configuration
# Copy this file to .env and update with your values
# =============================================================================

# Groq API Key (required)
GROQ_API_KEY=your-groq-api-key-here

# PostgreSQL Database URL (using external Neon PostgreSQL)
# Get your free database at: https://neon.tech
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# JWT Secret Key (change this to a secure random string in production)
# Use: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# Access Token Expiry (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Origins (comma-separated list of allowed origins)
# Update with your production domain
CORS_ORIGINS=["http://localhost:80", "http://localhost:3000", "http://localhost:5173"]
